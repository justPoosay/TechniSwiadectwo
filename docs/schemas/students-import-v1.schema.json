{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:techniswiadectwo:schemas:v1:students-import",
  "title": "StudentsImportBatch",
  "description": "Schemat paczki importu danych uczniów w formacie JSON dla systemu TechniŚwiadectwo (v1.0)",
  "type": "object",
  "required": ["version", "students"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Wersja formatu paczki danych."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Znacznik czasu wygenerowania pliku w formacie ISO 8601."
    },
    "source_system": {
      "type": "string",
      "description": "Nazwa systemu źródłowego, z którego wyeksportowano dane."
    },
    "academic_year": {
      "type": "string",
      "pattern": "^[0-9]{4}/[0-9]{4}$",
      "description": "Domyślny rok szkolny paczki, np. 2025/2026."
    },
    "students": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/StudentItem"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "StudentItem": {
      "type": "object",
      "required": [
        "register_number",
        "first_name",
        "last_name",
        "date_of_birth",
        "place_of_birth"
      ],
      "properties": {
        "external_id": {
          "type": ["string", "null"],
          "maxLength": 100,
          "description": "Identyfikator ucznia w systemie źródłowym."
        },
        "register_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Numer w księdze uczniów szkoły."
        },
        "first_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "second_name": {
          "type": ["string", "null"],
          "maxLength": 100
        },
        "last_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "date_of_birth": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Data urodzenia w formacie YYYY-MM-DD."
        },
        "place_of_birth": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pesel": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{11}$",
          "description": "11-cyfrowy numer PESEL."
        },
        "id_document": {
          "type": ["object", "null"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["PASSPORT", "ID_CARD", "OTHER"]
            },
            "number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "required": ["type", "number"],
          "additionalProperties": false
        },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "GRADUATED", "WITHDRAWN"],
          "default": "ACTIVE"
        },
        "cohort": {
          "type": ["object", "null"],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 10
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          },
          "required": ["name"],
          "additionalProperties": false
        },
        "admission": {
          "type": ["object", "null"],
          "properties": {
            "event_date": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "document_number": {
              "type": ["string", "null"],
              "maxLength": 100
            },
            "notes": {
              "type": ["string", "null"]
            }
          },
          "required": ["event_date"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["pesel"],
          "properties": {
            "pesel": { "type": "string" }
          }
        },
        {
          "required": ["id_document"],
          "properties": {
            "id_document": { "type": "object" }
          }
        }
      ]
    }
  }
}
